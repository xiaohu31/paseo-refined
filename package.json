{
  "name": "paseo-refined",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform timeline, tool-call, and Zinc theme refinements for Paseo.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "agent-ui",
    "zinc-theme"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "!client/**/*.test.ts",
    "!client/**/*.test.tsx",
    "!shared/**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test client/*.test.ts shared/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.9.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
